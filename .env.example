# ============================================================================
# Pathrise — Environment Variables
# Copy this file to `.env.local` (Next.js) or set them in Vercel dashboard
# under Settings → Environment Variables.
# All NEXT_PUBLIC_* vars are exposed to the browser — never put secrets here.
# ============================================================================

# --- Site URL ---
# Used for Open Graph tags, sitemap, robots.txt, canonical URLs
NEXT_PUBLIC_SITE_URL=https://pathrise.io

# --- Google Analytics 4 (optional, leave empty to disable) ---
# Format: G-XXXXXXXXXX
# Create at: https://analytics.google.com/
NEXT_PUBLIC_GA_ID=

# --- Meta (Facebook) Pixel ID (optional, leave empty to disable) ---
# Format: 123456789012345 (15-16 digit number)
# Create at: https://www.facebook.com/business/help/952192354843755
NEXT_PUBLIC_META_PIXEL_ID=

# --- LinkedIn Insight Tag partner ID (optional, leave empty to disable) ---
# Format: 1234567 (numeric)
# Create at: https://www.linkedin.com/help/linkedin/agent/8440044
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# --- Vercel Web Analytics (optional, no ID needed) ---
# Enable in Vercel dashboard → Analytics tab (free, privacy-friendly)

# --- Database (Prisma — only needed for future backend features) ---
# Vercel Postgres or external DB URL — leave empty if not using Prisma yet
DATABASE_URL="file:./dev.db"
